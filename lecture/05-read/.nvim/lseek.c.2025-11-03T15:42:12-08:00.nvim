#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main() {
  char buf[12];

  int fd = open("tmp", O_RDWR | O_CREAT, 0);
  write(fd, "Hello World!\n", strlen("Hello World\n"));
  lseek(fd, -6, SEEK_CUR);
  read(fd, buf, 6);

  write(STDOUT_FILENO, buf, strlen(buf));
  int c = close(fd);
}
