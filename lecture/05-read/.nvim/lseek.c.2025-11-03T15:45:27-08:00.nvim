#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main() {
  char buf[12];

  int fd = open("tmp", O_RDWR | O_CREAT);
  if (fd == -1){
  perror("Open failed\n");
      }

  write(fd, "Hello World!\n", strlen("Hello World\n"));
  lseek(fd, -6, SEEK_CUR);
  read(fd, buf, 6);

  write(STDOUT_FILENO, buf, 6);
  close(fd);
  write(STDOUT_FILENO, "\n", strlen("\n"));
}
