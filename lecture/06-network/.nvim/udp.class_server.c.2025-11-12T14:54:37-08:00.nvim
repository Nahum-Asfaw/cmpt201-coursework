// Server
#include <errno.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

int main() {
  printf("SERVER:\n");

  // socket
  int socket_fd = socket(AF_UNIX, SOCK_DGRAM, 0);
  if (socket_fd == -1) {
    perror("Socket failed!\n");
    exit(EXIT_FAILURE);
  }

  // Remove the existing socket (if present)
  if (remove("socket_fun") == -1 && errno != ENOENT) {
    perror("Remove failed!\n");
    exit(EXIT_FAILURE);
  }

  // bind
  struct sockaddr_un sockstruct;
  sockstruct.sun_family = AF_UNIX;
  snprintf(sockstruct.sun_path, 108, "da_udp_socket");

  if (bind(socket_fd, (struct sockaddr *)&sockstruct,
           sizeof(struct sockaddr_un)) == -1) {
    perror("Bind failed!\n");
    exit(EXIT_FAILURE);
  }
  // listen
  if (listen(socket_fd, 10) == -1) {
    perror("Listen failed!\n");
    exit(EXIT_FAILURE);
  }

  // accept

  int connected_fd;
  while (true) {
    printf("Accepting New Clients!\n");
    if ((connected_fd = accept(socket_fd, NULL, NULL)) == -1) {
      perror("Accept failed!\n");
      exit(EXIT_FAILURE);
    }
  }

  // read
  const int size = 1024;
  char buff[size];

  struct sockaddr_un return_address;
  memset(&return_address, 0, sizeof(struct sockaddr_un));

  recvfrom(socket_fd, buff, size, 0, );

  int bytes_read;
  while ((bytes_read = read(connected_fd, buff, size)) > 0) {

    // write
    write(STDOUT_FILENO, buff, bytes_read);
    if (bytes_read == -1) {
      perror("Read failed!\n");
      exit(EXIT_FAILURE);
    }
  }
  return 0;
}
