// this is the client

#include <netinet/in.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

int main() {
  printf("CLIENT:\n");

  // socket
  int socket_fd = socket(AF_UNIX, SOCK_STREAM, 0);
  if (socket_fd == -1) {
    perror("Socket failed!\n");
    exit(EXIT_FAILURE);
  }

  // connect
  struct sockaddr_in sockstruct;
  sockstruct.sin_family = AF_INET;
  sockstruct.sid_port = htons(1042);
  // snprintf(sockstruct.sun_path, 108, "socket_fun");

  if (connect(socket_fd, (struct sockaddr *)&sockstruct,
              sizeof(struct sockaddr_un)) == -1) {
    perror("Connect failed!\n");
    exit(EXIT_FAILURE);
  }

  // write
  char *msg = "Sockets are not fun (and Hello World).\n";
  int bytes_written = write(socket_fd, msg, strlen(msg));
  if (bytes_written == -1) {
    perror("Write failed!\n");
    exit(EXIT_FAILURE);
  }

  // close
  close(socket_fd);

  return 0;
}
