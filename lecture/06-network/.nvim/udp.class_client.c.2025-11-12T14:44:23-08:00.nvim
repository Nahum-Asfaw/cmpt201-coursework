// this is the client

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

int main() {
  printf("CLIENT:\n");

  // socket
  int socket_fd = socket(AF_UNIX, SOCK_DGRAM, 0);
  if (socket_fd == -1) {
    perror("Socket failed!\n");
    exit(EXIT_FAILURE);
  }

  // create dest address
  struct sockaddr_un *addr;
  memset(addr, 0, sizeof(struct sockaddr_un));

  // write
  char *msg = "I'm sending this; hope you get it.\n";
  int bytes_written = sendto(socket_fd, msg, strlen(msg), 0, );
  if (bytes_written == -1) {
    perror("Write failed!\n");
    exit(EXIT_FAILURE);
  }

  // close
  close(socket_fd);

  return 0;
}
