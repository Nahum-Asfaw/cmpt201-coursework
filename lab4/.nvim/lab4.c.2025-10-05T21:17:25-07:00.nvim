//
//  // get starting address
//  char *location = sbrk(0)
//

#define _DEFAULT_SOURCE
#define _ISOC99_SOURCE

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

#define BUF_SIZE 1024

void print_out(char *format, void *data, size_t data_size) {
  char buf[BUF_SIZE];
  ssize_t len = snprintf(buf, BUF_SIZE, format,
                         data_size == sizeof(uint64_t) ? *(uint64_t *)data
                                                       : *(void **)data);
  write(STDOUT_FILENO, buf, len);
}

struct header {
  uint64_t size;
  struct header *next;
};

void initilize_first(struct header *block) {
  block->next = NULL;
  block->size = 0;
}

void initilize_second(struct header *first, struct header *second) {
  second->next = first;
  second->size = 0;
}

int main() {
  char *start_address = sbrk(0);
  char *second_address = sbrk(256);
  struct header *first_block = (struct header *)start_address;
  struct header *second_block = (struct header *)second_address;

  initilize_first(first_block);
  initilize_second(first_block, second_block);
}
