#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SIZE 5

void processInput(char *input, char *history) {

  if (strcmp(input, "print")) {
    printf("%s\n", history);
  }
}

void reading(char *input, char *history, size_t n) {

  while (strcmp(input, "print") == 0) {
    printf("Enter: ");
    getline(&input, &n, stdin);
  }
}

static size_t n = 0; // lab 1

int main() {

  char *input; // lab 1 implementation
  char *history[SIZE];
  int lineNum = 0;

  while (1) {

    printf("Enter: ");

    getline(&history[lineNum], &n, stdin);

    printf("You entered: %s and previously entered %s", history[lineNum],
           history[lineNum - 1]);

    if (strcmp(history[lineNum], "print")) {
      for (int i = 0; i <= lineNum; i++) {
        printf("%s", history[i]);
      }
    }

    printf("\n");

    lineNum++;
  }

  return 0;
}
