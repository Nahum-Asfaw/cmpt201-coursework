#include <ctype.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

struct header {
  uint64_t size;
  struct header *next;
};

int main() {
  printf("sizof(int32_t) * 2 = %ld\n", sizeof(int32_t) * 2);
  printf("sizeof(struct header *) = %ld\n", sizeof(struct header *));
  printf("sizeof(struct header) = %ld\n", sizeof(struct header));
}
