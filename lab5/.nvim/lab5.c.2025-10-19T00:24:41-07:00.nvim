  // printf("The ID for Best-Fit algorithm is: %d\n", best_fit_id);
  // printf("The ID for Worst-Fit algorithm is: %d\n", worst_fit_id);

  free(free_block1);
  free(free_block2);
  free(free_block3);
  free(free_block4);
  free(free_block5);
  free(free_block_example);

  return 0;
}
