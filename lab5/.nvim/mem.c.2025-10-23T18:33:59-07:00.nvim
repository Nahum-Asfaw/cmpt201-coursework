#include <ctype.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

struct header {
  uint64_t size;
  struct header *next;
};

int main() {
  for (int i = 0; i < UINT64_MAX; i++){
    printf("%d ", i);
    i++;
  }
  printf("sizof(int32_t) * 2 = %ld\n", sizeof(int32_t) * 2);
  printf("sizeof(struct header *) = %ld\n", sizeof(struct header *));
  printf("sizeof(struct header) = %ld\n", sizeof(struct header));
  printf("UINT64_MAX = %ld\n", UINT64_MAX);
}
