#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

struct header {
  uint64_t size;
  struct header *next;
  int id;
  bool free;
};

struct header *list_new(void) {

  struct header *newHeader = malloc(sizeof(*newHeader));
  if (newHeader == NULL) {
    perror("Malloc failed\n");
    exit(EXIT_FAILURE);
  }
  return newHeader;
}

void initialize_block(struct header *block, uint64_t size, struct header *next,
                      int id, bool a) {
  block->size = size;
  block->next = next;
  block->id = id;
  block->free = a;
}

void print_list(struct header *free_list_ptr) {

  struct header *current = free_list_ptr;
  int i = 0;
  while (current != NULL) {
    printf("Element: %d, Size: %lu, ID: %d, ", i, current->size, current->id);
    if (current->free == true)
      printf("Free: true\n");
    else
      printf("Free: false\n");
    printf("---------------------------------------\n");
    i++;
    current = current->next;
  }
}
void add_id(struct header **free_list_ptr) {
  struct header *current = *free_list_ptr;
  while (current != NULL) {
    current->id++;
    current = current->next;
  }
}

//  pass a double header to edit free_list_ptr
int find_first_fit(struct header **free_list_ptr, uint64_t size) {
  int find_first_id = -1;
  uint64_t old_size = 0;
  struct header *current = *free_list_ptr; // start at the head
  while (current != NULL) {                // go through the list
    if (current->size >= size) {           // first block large enough
                                 // split the block in two, make new head
      find_first_id = current->id;
      old_size = current->size;
      current->size = size;
      add_id(&current);
      current->free = false;

      // all of this could be handled by initialize block...
      struct header *new_head = list_new();
      initialize_block(new_head, old_size - size, *free_list_ptr, find_first_id,
                       true);

      *free_list_ptr = new_head;
      break;
    }
    current = current->next;
  }
  return find_first_id;
}

