// a coalescing algorithm would require me to free...
void coalecse(struct header **free_list_ptr) {
  struct header *current = *free_list_ptr;
  struct header *prev = NULL;
  while (current != NULL) {
    if (prev->free == true == current->free) { // both free
      // coalecse
      current->next = current;
      current->size = current->size + prev->size;
    }
    prev = current;
    current = current->next;
  }
}

